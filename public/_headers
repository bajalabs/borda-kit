# Response headers for Netlify and Cloudflare Pages (both read this file from the output folder).
# Vercel reads vercel.json; GitHub Pages does not support custom headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/:slug/contact.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="contact.vcf"

/:lang/:slug/contact.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="contact.vcf"

/.well-known/borda-build.json
  Cache-Control: no-cache
