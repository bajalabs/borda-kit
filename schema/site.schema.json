{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema this file follows (for editors).",
      "type": "string"
    },
    "primary": {
      "default": false,
      "description": "The site served at /; other sites are served under /<language>/.",
      "type": "boolean"
    },
    "demo": {
      "default": false,
      "description": "Demo content: never indexed, and refused by a production build.",
      "type": "boolean"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}-[A-Z]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The brand or organisation name."
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "The website's host as shown on the cards, for example example.com."
    },
    "boards_domain": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "website_url": {
      "type": "string",
      "format": "uri"
    },
    "theme": {
      "default": "default",
      "type": "string",
      "enum": [
        "default",
        "navy",
        "charcoal",
        "sand",
        "forest",
        "ink"
      ]
    },
    "privacy_url": {
      "description": "Linked from the lead form's consent.",
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "form": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "format": "uri",
              "description": "Where the lead form posts (see content/README.md, Lead form)."
            },
            "turnstile_site_key": {
              "description": "Adds a Cloudflare Turnstile challenge when set.",
              "type": [
                "string",
                "null"
              ]
            },
            "consent_version": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "redirects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^\\/[a-z0-9/_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^(https?:\\/\\/|\\/(?!\\/))"
          },
          "status": {
            "default": 301,
            "anyOf": [
              {
                "type": "number",
                "const": 301
              },
              {
                "type": "number",
                "const": 302
              },
              {
                "type": "number",
                "const": 307
              },
              {
                "type": "number",
                "const": 308
              }
            ]
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "locale",
    "name",
    "domain",
    "boards_domain",
    "website_url"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/bajalabs/borda-kit/main/schema/site.schema.json",
  "title": "borda-kit site (content/<site>/site.json)"
}
